<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.eb_study.board.free.model.dao.FreeBoardDao">

	<sql id="listFLFOption">
		<where>
			<if test='startDate neq null'>
	 			AND created &gt;= #{startDate}
			</if>
			<if test='endDate neq null'>
	 			AND created &lt; DATE_ADD(STR_TO_DATE('2025-03-31', '%Y-%m-%d'), INTERVAL 1 DAY)
			</if>
			<if test='category gt 0'>
				AND category_no = #{category}
			</if>
			<if test='query neq null and !query.isEmpty()'>
				AND (writer LIKE CONCAT('%', #{query}, '%') OR title LIKE CONCAT('%', #{query}, '%') OR content LIKE CONCAT('%', #{query}, '%'))
			</if>
		</where>
	</sql>

	<sql id="joinBoardToCategoryPrefix">
		SELECT B.*, name AS CATEGORY_NAME
		FROM (
			SELECT * FROM BOARD
	</sql>

	<sql id="joinBoardToCategorySuffix">
		) B
		JOIN CATEGORY USING(category_no)
	</sql>

	<sql id="attachs">
		SELECT * FROM ATTACH
		WHERE board_no = #{boardNo}
	</sql>

	<select id="getBoardList" parameterType="freeBoardSearchOption" resultType="boardSelect">
		<include refid="joinBoardToCategoryPrefix" />
			<include refid="listFLFOption" />
			ORDER BY created DESC, board_no DESC
			LIMIT #{offset}, #{perPage}
		<include refid="joinBoardToCategorySuffix" />
		ORDER BY created DESC, board_no DESC
	</select>

	<select id="getBoard" parameterType="int" resultType="boardSelect">
		<include refid="joinBoardToCategoryPrefix" />
			WHERE board_no = #{boardNo}
		<include refid="joinBoardToCategorySuffix" />
	</select>

	<select id="getAllBoardCount" parameterType="freeBoardSearchOption" resultType="int">
		SELECT COUNT(*) FROM BOARD
		<include refid="listFLFOption" />
	</select>

	<select id="getAttachList" parameterType="int" resultType="attachMetadata">
		<include refid="attachs" />
		ORDER BY attach_no
	</select>

	<select id="getAttach" parameterType="attachNum" resultType="attachMetadata">
		<include refid="attachs" />
		AND attach_no = #{attachNo}
	</select>


	<insert id="insertBoard" parameterType="boardInsert" useGeneratedKeys="true" keyColumn="BOARD_NO" keyProperty="boardNo" >
		INSERT INTO BOARD(category_no, writer, password, title, content, attach)
		VALUES (#{categoryNo}, #{writer}, #{password}, #{title}, #{content}, #{attach})
	</insert>

	<update id="updateBoard" parameterType="boardUpdate">
		UPDATE BOARD
		SET title = #{title},
			content = #{content},
			updated = NOW()
		WHERE board_no = #{boardNo}
	</update>

	<insert id="insertReply" parameterType="replyInsert">
		INSERT INTO REPLY(board_no, content)
		VALUES (#{boardNo}, #{content})
	</insert>

	<insert id="insertAttachList" parameterType="list">
		INSERT INTO ATTACH
		VALUES 
		<foreach collection="list" item="a" separator=",">
			(#{a.boardNo}, #{a.attachNo}, #{a.fileOrigin}, #{a.fileRename}, #{a.ext})
		</foreach>
	</insert>

	<delete id="deleteAttachList" parameterType="list">
		DELETE FROM ATTACH
		WHERE attach_no IN <foreach collection="list" item="a" open="(" close=")" separator=",">
			<bind name="boardNo" value="a.getBoardNo()"/>
			#{a.attachNo}
		</foreach> 
		AND board_no = #{boardNo}
	</delete>
</mapper>